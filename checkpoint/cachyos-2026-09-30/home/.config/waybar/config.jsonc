{
    "layer": "top",
    "position": "top",
    "height": 34,
    "exclusive": true,
    "spacing": 8,
    "margin-top": 3,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": [
        "custom/arch",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "network",
        "bluetooth",
        "pulseaudio",
        "battery"
    ],

    "custom/arch": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "/home/snehil/.local/bin/personal-power-menu",
        "on-click-right": "ghostty -e btop"
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate",
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": "",
            "empty": ""
        },
        "persistent-workspaces": {
            "*": 5
        }
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "on-click": "qs ipc -p ~/.config/quickshell/personal call personal.calendar toggle",
        "calendar": {
            "mode"          : "month",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
                "months":     "<span color='#ffb59f'><b>{}</b></span>",
                "days":       "<span color='#f9dcd5'>{}</span>",
                "weeks":      "<span color='#aa8980'><b>W{}</b></span>",
                "weekdays":   "<span color='#e4beb4'><b>{}</b></span>",
                "today":      "<span color='#1e100c' background='#ffb59f'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "tooltip-format": "{ifname}\n{essid}\n{ipaddr}",
        "on-click": "qs ipc -p ~/.config/quickshell/personal call personal.network toggle"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂱",
        "tooltip-format": "{controller_alias}",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click": "qs ipc -p ~/.config/quickshell/personal call personal.bluetooth toggle"
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰝟 {volume}%",
        "tooltip-format": "{volume}% - {desc}",
        "scroll-step": 5,
        "on-click": "qs ipc -p ~/.config/quickshell/personal call personal.audio toggle",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "tray": {
        "icon-size": 20,
        "spacing": 12
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
        "states": {
            "warning": 30,
            "critical": 15
        },
        "on-click": "qs ipc -p ~/.config/quickshell/personal call personal.battery toggle"
    }
}
